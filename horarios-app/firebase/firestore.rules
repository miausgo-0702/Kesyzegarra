rules_version = '2';
// Reglas de seguridad de Mis Horarios (pegar en Firestore > Reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    function logueado() { return request.auth != null; }
    function admin() {
      return logueado() && request.auth.token.email in
        ['lezana@admin.mishorarios.app', 'julianpz@admin.mishorarios.app'];
    }
    function empleado() { return logueado() && exists(/databases/$(database)/documents/empleados/$(request.auth.uid)); }

    // Planillas de horarios: las ven todos los usuarios, las editan los administradores.
    match /config/{doc} {
      allow read: if logueado();
      allow write: if admin();
    }
    // Empleados registrados: cada uno ve el suyo; los administradores ven todos.
    match /empleados/{uid} {
      allow read: if admin() || (logueado() && request.auth.uid == uid);
      allow create: if logueado() && !admin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['dni', 'persona', 'creado'])
        && request.resource.data.dni is string && request.resource.data.persona is string
        && request.auth.token.email == request.resource.data.dni + '@empleados.mishorarios.app';
      allow update: if admin();
      allow delete: if admin();
    }
    // Una persona de la planilla = una sola cuenta.
    match /personas/{p} {
      allow get: if logueado();
      allow list: if admin() || empleado();
      allow create: if logueado() && !admin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }
    // Cambios de turno / francos: los cargan los administradores. El empleado solo puede
    // aceptar o rechazar (una vez) los cambios pendientes que son suyos.
    match /cambios/{id} {
      allow read: if admin() || empleado();
      allow create, delete: if admin();
      allow update: if admin() || (empleado()
        && get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.persona == resource.data.persona
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['aceptado', 'rechazado']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta', 'respondido'])
        && request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 300);
    }
    // Dispositivos para notificaciones push: cada usuario registra / borra solo los suyos.
    // Solo los leen las funciones del servidor.
    match /tokens/{t} {
      allow create, update: if logueado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'plataforma', 'actualizado']);
      allow delete: if logueado() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
    // Uso interno de las funciones del servidor.
    match /notifEnviadas/{d} { allow read, write: if false; }
    match /_pruebaEnvios/{d} { allow read, write: if false; }
    match /avisos/{id} {
      allow read: if admin() || empleado();
      allow write: if admin();
    }
  }
}
